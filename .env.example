# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Where slash commands get registered:
#   (empty)             Global: works in every server the bot is in, but new or changed
#                       commands can take up to an hour to show up.
#   all                 Instantly in every server the bot is in, and in any server it joins later.
#                       Best for testing across several servers.
#   111111,222222       Instantly in just the listed server IDs (comma separated).
GUILD_ID=
