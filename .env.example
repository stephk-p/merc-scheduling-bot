# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Where slash commands get registered:
#   (empty)             Global: works in every server the bot is in, but new or changed
#                       commands can take up to an hour to show up.
#   all                 Instantly in every server the bot is in, and in any server it joins later.
#                       Best for testing across several servers.
#   111111,222222       Instantly in just the listed server IDs (comma separated).
GUILD_ID=

# Auto-update from GitHub (needs git, and the bot folder must be a git clone).
# When true, the bot checks GitHub when it starts and every day at UPDATE_CHECK_TIME (24-hour clock)
# in UPDATE_CHECK_TIMEZONE. If there are new commits it pulls them and restarts itself; if not, it
# keeps running. Leave false on a PC where you edit the code.
AUTO_UPDATE=false
UPDATE_CHECK_TIME=03:00
UPDATE_CHECK_TIMEZONE=America/New_York
